generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
enum AgentType {
  PRIBADI    @map("Pribadi")
  PERUSAHAAN @map("Perusahaan")
}
enum Role {
  SUPERADMIN @map("superadmin") 
  ADMIN      @map("admin")
  FINANCE    @map("finance")    
  MARKETING  @map("marketing")
  CUSTOMER   @map("customer")
  BANK       @map("bank")
  AGENT      @map("agent")
}
enum UnitStatus {
  AVAILABLE  @map("Available")
  BOOKING    @map("Booking")
  TERJUAL    @map("Terjual")
  HOLD       @map("Hold")
}
enum ActionType {
  CREATE
  UPDATE
  DELETE
}
enum PaymentStatus {
  BELUM_BAYAR         @map("Belum Bayar")
  MENUNGGU_KONFIRMASI @map("Menunggu Konfirmasi") 
  LUNAS               @map("Lunas")
}
enum PaymentMethod {
