    const imageUrl = await this.cloudinaryService.uploadImage(
      fileBuffer,
      `customer_${documentType}`,
    );

    const updateData = {
      [documentType]: imageUrl,
    };

    const result = await this.customerRepo.update(id, updateData);

    return CustomerMapper.toDomain(result);
  }
