generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                      Int                   @id @default(autoincrement())
  username                String                @db.VarChar(100)
  email                   String                @unique @db.VarChar(100)
  password                String                @db.VarChar(255)
  role                    Role
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")
  agents                  Agent[]
  auditLogs               AuditLog[]
  customers               Customer[]
  persetujuanBatal        PengajuanBatal[]      @relation("PenyetujuBatal")
  pengajuanBatal          PengajuanBatal[]      @relation("PengajuBatal")
  persetujuanGantiKavling RiwayatGantiKavling[] @relation("PenyetujuGantiKavling")
  pengajuanGantiKavling   RiwayatGantiKavling[] @relation("PengajuGantiKavling")
  progressProyekAsMandor  ProgressProyek[]      @relation("ProgressMandor")
  spkAsMandor             Spk[]                 @relation("SpkMandor")
  spkDiajukan             Spk[]                 @relation("SpkDiajukan")
  spkDisetujui            Spk[]                 @relation("SpkDisetujui")
  spkPembayaranDiajukan   SpkPembayaran[]       @relation("SpkPembayaranDiajukan")
  spkPembayaranDisetujui  SpkPembayaran[]       @relation("SpkPembayaranDisetujui")
  spkPembayaranDibayar    SpkPembayaran[]       @relation("SpkPembayaranDibayar")
  notarisPembayaranDibayar NotarisPembayaran[]  @relation("NotarisPembayaranDibayar")
  bankKprPembayaranDibayar BankKprPembayaran[]  @relation("BankKprPembayaranDibayar")
  agentPencairanDiajukan  AgentPencairan[]       @relation("AgentPencairanDiajukan")
  agentPencairanDibayar   AgentPencairan[]       @relation("AgentPencairanDibayar")
  tahapanReports          TahapanProyek[]       @relation("TahapanReporter")
  mandorProfile           Mandor?
  tukangList              Tukang[]              @relation("TukangMandor")
  notifications           Notification[]

  @@map("users")
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  type      NotificationType
  title     String           @db.VarChar(255)
  message   String           @db.Text
  data      Json?
  linkPath  String?          @map("link_path") @db.VarChar(255)
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model Mandor {
  id               Int              @id @default(autoincrement())
  userId           Int              @unique @map("user_id")
  namaBank         String           @map("nama_bank") @db.VarChar(100)
  noRekening       String           @map("no_rekening") @db.VarChar(50)
  atasNamaRekening String           @map("atas_nama_rekening") @db.VarChar(150)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  rekeningList     MandorRekening[]

  @@map("mandors")
}

model MandorRekening {
  id               Int             @id @default(autoincrement())
  mandorId         Int             @map("mandor_id")
  label            String?         @db.VarChar(100)
  namaBank         String          @map("nama_bank") @db.VarChar(100)
  noRekening       String          @map("no_rekening") @db.VarChar(50)
  atasNamaRekening String          @map("atas_nama_rekening") @db.VarChar(150)
  isDefault        Boolean         @default(false) @map("is_default")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  mandor           Mandor          @relation(fields: [mandorId], references: [id], onDelete: Cascade)
  spkPembayaranList SpkPembayaran[]

  @@index([mandorId], map: "mandor_rekening_mandor_id_fkey")
  @@map("mandor_rekening")
}

model Customer {
  id                Int         @id @default(autoincrement())
  userId            Int?        @map("user_id")
  nikKtp            String      @unique @map("nik_ktp") @db.VarChar(20)
  nama              String      @db.VarChar(150)
  noHp              String      @map("no_hp") @db.VarChar(20)
  alamatKtp         String      @map("alamat_ktp") @db.Text
  alamatTinggal     String?     @map("alamat_tinggal") @db.Text
  email             String?     @db.VarChar(100)
  pekerjaan         String?     @db.VarChar(100)
  perusahaan        String?     @db.VarChar(150)
  alamatKoresponden String?     @map("alamat_korespondensi") @db.Text
  fileKtp           String?     @map("file_ktp") @db.VarChar(255)
  fileKk            String?     @map("file_kk") @db.VarChar(255)
  fileNpwp          String?     @map("file_npwp") @db.VarChar(255)
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  bank              String?     @db.VarChar(100)
  dokumenLainnya    Json?       @map("dokumen_lainnya")
  user              User?       @relation(fields: [userId], references: [id])
  penjualan         Penjualan[]
  tagihan           Tagihan[]
  kodeBillingPph    KodeBillingPph[]
  suketPph          SuketPph[]
  fakturPajakPpn    FakturPajakPpn[]

  @@index([userId], map: "customers_user_id_fkey")
  @@map("customers")
}

model Perumahan {
  id             Int              @id @default(autoincrement())
  nama           String           @unique @db.VarChar(150)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  alamat         String           @unique @db.VarChar(150)
  logo           String           @unique @db.VarChar(150)
  bankRekeningPt BankRekeningPt[]
  kavlings       Kavling[]

  @@map("perumahan")
}

model BankRekeningPt {
  id          Int         @id @default(autoincrement())
  namaBank    String      @map("nama_bank") @db.VarChar(100)
  noRekening  String      @map("no_rekening") @db.VarChar(50)
  atasNama    String      @map("atas_nama") @db.VarChar(150)
  createdAt   DateTime    @default(now()) @map("created_at")
  perumahanId Int         @map("perumahan_id")
  perumahan   Perumahan   @relation(fields: [perumahanId], references: [id])
  kavlings    Kavling[]
  penjualan   Penjualan[]
  spks        Spk[]

  @@index([perumahanId], map: "bank_rekening_pt_perumahan_id_fkey")
  @@map("bank_rekening_pt")
}

model Notaris {
  id                 Int                  @id @default(autoincrement())
  nama               String               @db.VarChar(150)
  biayaAjb           Decimal?             @map("biaya_ajb") @db.Decimal(15, 2)
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  biayaPpjb          Decimal?             @map("biaya_ppjb") @db.Decimal(15, 2)
  nomorIjin          String?              @map("nomor_ijin") @db.VarChar(50)
  nomorKtp           String?              @map("nomor_ktp") @db.VarChar(20)
  alamat             String?              @db.Text
  noHp               String?              @map("no_hp") @db.VarChar(20)
  namaBank           String?              @map("nama_bank") @db.VarChar(100)
  noRekening         String?              @map("no_rekening") @db.VarChar(50)
  atasNamaRekening   String?              @map("atas_nama_rekening") @db.VarChar(150)
  detailKavlingPajak DetailKavlingPajak[]
  pics               PicNotaris[]

  @@map("notaris")
}

model PicNotaris {
  id        Int      @id @default(autoincrement())
  notarisId Int      @map("notaris_id")
  nama      String   @db.VarChar(150)
  noHp      String   @map("no_hp") @db.VarChar(20)
  alamat    String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  notaris   Notaris  @relation(fields: [notarisId], references: [id], onDelete: Cascade)

  @@index([notarisId], map: "pic_notaris_notaris_id_fkey")
  @@map("pic_notaris")
}

model PerusahaanAgent {
  id                  Int      @id @default(autoincrement())
  nama                String   @db.VarChar(150)
  akte                String?  @db.VarChar(255)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  atasNamaRekening    String?  @map("atas_nama_rekening") @db.VarChar(150)
  namaBank            String?  @map("nama_bank") @db.VarChar(100)
  noRekening          String?  @map("no_rekening") @db.VarChar(50)
  npwp                String?  @db.VarChar(50)
  feeMarketingPct     Decimal? @map("fee_marketing_pct") @db.Decimal(5, 2)
  feeClosingNominal   Decimal? @map("fee_closing_nominal") @db.Decimal(15, 2)
  potonganPph         Decimal? @map("potongan_pph") @db.Decimal(5, 2)
  isPkp               Boolean  @default(false) @map("is_pkp")
  agents              Agent[]

  @@map("perusahaan_agents")
}

model Agent {
  id                     Int              @id @default(autoincrement())
  nik                    String           @unique @db.VarChar(20)
  kodeSales              String?          @unique @map("kode_sales") @db.VarChar(20)
  nama                   String           @db.VarChar(150)
  alamat                 String?          @db.Text
  noHp                   String           @map("no_hp") @db.VarChar(20)
  email                  String?          @db.VarChar(100)
  status                 AgentStatus      @default(PENDING)
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")
  fileKtp                String?          @map("file_ktp") @db.VarChar(255)
  fileKtpDirektur        String?          @map("file_ktp_direktur") @db.VarChar(255)
  fileNpwp               String?          @map("file_npwp") @db.VarChar(255)
  fileNpwpPerusahaan     String?          @map("file_npwp_perusahaan") @db.VarChar(255)
  fileSuratKeterangan    String?          @map("file_surat_keterangan") @db.VarChar(255)
  kwitansiBookingFee     String?          @map("kwitansi_booking_fee") @db.VarChar(255)
  type                   AgentType        @default(PRIBADI)
  userId                 Int?             @map("user_id")
  feeMarketingPct        Decimal?         @map("fee_marketing_pct") @db.Decimal(5, 2)
  potonganPph            Decimal?         @map("potongan_pph") @db.Decimal(5, 2)
  atasNamaRekening       String?          @map("atas_nama_rekening") @db.VarChar(150)
  namaBank               String?          @map("nama_bank") @db.VarChar(100)
  noRekening             String?          @map("no_rekening") @db.VarChar(50)
  perusahaanAgentId      Int?             @map("perusahaan_agent_id")
  ttdData                String?          @db.LongText
  fileSuratPernyataan    String?          @map("file_surat_pernyataan") @db.VarChar(255)
  defaultSuratPernyataan String?          @map("default_surat_pernyataan") @db.VarChar(255)
  feeClosingNominal      Decimal?         @map("fee_closing_nominal") @db.Decimal(15, 2)
  isInHouse              Boolean          @default(false) @map("is_in_house")
  perusahaanAgent        PerusahaanAgent? @relation(fields: [perusahaanAgentId], references: [id])
  user                   User?            @relation(fields: [userId], references: [id])
  fees                   FeeAgent[]
  penjualan              Penjualan[]
  pics                   PicAgent[]
  agentPencairanList     AgentPencairan[]

  @@index([perusahaanAgentId], map: "agents_perusahaan_agent_id_fkey")
  @@index([userId], map: "agents_user_id_fkey")
  @@map("agents")
}

model PicAgent {
  id        Int      @id @default(autoincrement())
  agentId   Int      @map("agent_id")
  nama      String   @db.VarChar(150)
  noHp      String   @map("no_hp") @db.VarChar(20)
  alamat    String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId], map: "pic_agents_agent_id_fkey")
  @@map("pic_agents")
}

model Kavling {
  id                  Int                   @id @default(autoincrement())
  perumahanId         Int                   @map("perumahan_id")
  blok                String                @db.VarChar(10)
  nomorUnit           String                @map("nomor_unit") @db.VarChar(10)
  status              UnitStatus            @default(AVAILABLE)
  filePbg             String?               @map("file_pbg") @db.VarChar(255)
  fileSertifikatTanah String?               @map("file_sertifikat_tanah") @db.VarChar(255)
  fileNopPbb          String?               @map("file_nop_pbb") @db.VarChar(255)
  nopd                String?               @db.VarChar(50)
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  luasBangunan        Decimal               @map("luas_bangunan") @db.Decimal(10, 2)
  luasTanah           Decimal               @map("luas_tanah") @db.Decimal(10, 2)
  namaTipe            String?                @map("nama_tipe") @db.VarChar(50)
  rekeningTujuanId    Int?                  @map("rekening_tujuan_id")
  hargaDasar          Decimal               @map("harga_dasar") @db.Decimal(15, 2)
  jenisKavling          JenisKavling                        @default(PERUMAHAN) @map("jenis_kavling")
  jumlahSertifikatTanah Int                                 @default(1) @map("jumlah_sertifikat_tanah")

  perumahan              Perumahan                          @relation(fields: [perumahanId], references: [id])
  rekeningTujuan         BankRekeningPt?                     @relation(fields: [rekeningTujuanId], references: [id])
  penjualan              Penjualan[]
  progressProyek         ProgressProyek?
  spkItem                SpkPenjualan?
  riwayatBaru            RiwayatGantiKavling[]              @relation("RiwayatKavlingBaru")
  riwayatLama            RiwayatGantiKavling[]              @relation("RiwayatKavlingLama")
  sertifikatTanahTambahan KavlingSertifikatTanahTambahan[]

  @@unique([perumahanId, blok, nomorUnit])
  @@index([rekeningTujuanId], map: "kavling_rekening_tujuan_id_fkey")
  @@map("kavling")
}

model KavlingSertifikatTanahTambahan {
  id                  Int      @id @default(autoincrement())
  kavlingId           Int      @map("kavling_id")
  urutan              Int
  filePbg             String?  @map("file_pbg") @db.VarChar(255)
  fileSertifikatTanah String?  @map("file_sertifikat_tanah") @db.VarChar(255)
  fileNopPbb          String?  @map("file_nop_pbb") @db.VarChar(255)
  nopd                String?  @db.VarChar(50)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  kavling             Kavling  @relation(fields: [kavlingId], references: [id], onDelete: Cascade)

  @@unique([kavlingId, urutan])
  @@index([kavlingId], map: "kavling_sertifikat_tanah_tambahan_kavling_id_fkey")
  @@map("kavling_sertifikat_tanah_tambahan")
}

model Penjualan {
  id                  Int                   @id @default(autoincrement())
  noTransaksi         String                @unique @map("no_transaksi") @db.VarChar(50)
  tanggal             DateTime              @db.Date
  customerId          Int                   @map("customer_id")
  kavlingId           Int                   @map("kavling_id")
  caraPembayaran      PaymentMethod?        @map("cara_pembayaran")
  hargaJual           Decimal?              @map("harga_jual") @db.Decimal(15, 2)
  dp                  Decimal?              @db.Decimal(15, 2)
  diskonPenjualan     Decimal?              @map("diskon_penjualan") @db.Decimal(15, 2)
  bank                String?               @db.VarChar(100)
  bankKprNamaRekening String?               @map("bank_kpr_nama_rekening") @db.VarChar(100)
  bankKprAtasNamaRekening String?           @map("bank_kpr_atas_nama_rekening") @db.VarChar(150)
  bankKprNoRekening   String?               @map("bank_kpr_no_rekening") @db.VarChar(50)
  nilaiPengajuanKpr   Decimal?              @map("nilai_pengajuan_kpr") @db.Decimal(15, 2)
  bookingFee          Decimal?              @map("booking_fee") @db.Decimal(15, 2)
  rekeningTujuanId    Int?                  @map("rekening_tujuan_id")
  status              PenjualanStatus       @default(BOOKED)
  alasanBatal         String?               @map("alasan_batal") @db.Text
  bookingFeeLunasBatal Boolean              @default(false) @map("booking_fee_lunas_batal")
  fileSpr             String?               @map("file_spr") @db.VarChar(255)
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  agentId             Int?                  @map("agent_id")
  fileBuktiBooking    String?               @map("file_bukti_booking") @db.VarChar(255)
  fileBuktiDp         String?               @map("file_bukti_dp") @db.VarChar(255)
  hargaPromosi        Decimal?              @map("harga_promosi") @db.Decimal(15, 2)
  ttdData             Json?                 @map("ttd_data")
  createdBy           String?               @map("created_by") @db.VarChar(100)
  biayaKpr            Decimal?              @map("biaya_kpr") @db.Decimal(15, 2)
  hargaDasar          Decimal               @map("harga_dasar") @db.Decimal(15, 2)
  plafonAwal          Decimal?              @map("plafon_awal") @db.Decimal(15, 2)
  dpTidakDibayar      Decimal?              @map("dp_tidak_dibayar") @db.Decimal(15, 2)
  plafonKredit        Decimal?              @map("plafon_kredit") @db.Decimal(15, 2)
  termin              Int?                  @map("termin")
  keteranganAngsuran  String?               @map("keterangan_angsuran") @db.Text
  tambahanKpr         Json?                 @map("tambahan_kpr")
  plafonAcc           Decimal?              @map("plafon_acc") @db.Decimal(15, 2)
  dpDibayar           Decimal?              @map("dp_dibayar") @db.Decimal(15, 2)
  detailKavlingPajak  DetailKavlingPajak?
  feeAgent            FeeAgent?
  pengajuanBatal      PengajuanBatal[]
  agent               Agent?                @relation(fields: [agentId], references: [id])
  customer            Customer              @relation(fields: [customerId], references: [id])
  kavling             Kavling               @relation(fields: [kavlingId], references: [id])
  rekeningTujuan      BankRekeningPt?       @relation(fields: [rekeningTujuanId], references: [id])
  progressPenjualan   ProgressPenjualan?
  progressProyek      ProgressProyek?
  riwayatGantiKavling RiwayatGantiKavling[]
  riwayatSpr          RiwayatSpr[]
  tagihan             Tagihan[]
  kodeBillingPph      KodeBillingPph[]
  suketPph            SuketPph[]
  fakturPajakPpn      FakturPajakPpn[]
  notarisPembayaranList NotarisPembayaran[]
  bankKprPembayaranList BankKprPembayaran[]
  agentPencairanList   AgentPencairan[]

  @@index([agentId], map: "penjualan_agent_id_fkey")
  @@index([customerId], map: "penjualan_customer_id_fkey")
  @@index([kavlingId], map: "penjualan_kavling_id_fkey")
  @@index([rekeningTujuanId], map: "penjualan_rekening_tujuan_id_fkey")
  @@map("penjualan")
}

enum StatusKodeBillingPph {
  MENUNGGU_BAYAR
  SUDAH_BAYAR
}

model KodeBillingPph {
  id               Int                  @id @default(autoincrement())
  customerId       Int                  @map("customer_id")
  penjualanId      Int                  @map("penjualan_id")
  sertifikatUrutan Int                  @default(1) @map("sertifikat_urutan")
  kodeBilling      String               @map("kode_billing") @db.VarChar(30)
  fileBilling      String               @map("file_billing") @db.VarChar(1000)
  fileBuktiBayar   String?              @map("file_bukti_bayar") @db.VarChar(1000)
  status           StatusKodeBillingPph @default(MENUNGGU_BAYAR)
  uploadedBy       Int?                 @map("uploaded_by")
  paidAt           DateTime?            @map("paid_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  customer         Customer             @relation(fields: [customerId], references: [id])
  penjualan        Penjualan            @relation(fields: [penjualanId], references: [id])

  @@unique([penjualanId, sertifikatUrutan])
  @@index([customerId], map: "kode_billing_pph_customer_id_fkey")
  @@index([kodeBilling], map: "kode_billing_pph_kode_billing_idx")
  @@map("kode_billing_pph")
}

model SuketPph {
  id               Int       @id @default(autoincrement())
  customerId       Int       @map("customer_id")
  penjualanId      Int       @map("penjualan_id")
  sertifikatUrutan Int       @default(1) @map("sertifikat_urutan")
  fileSuket        String    @map("file_suket") @db.VarChar(500)
  uploadedBy       Int?      @map("uploaded_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  customer         Customer  @relation(fields: [customerId], references: [id])
  penjualan        Penjualan @relation(fields: [penjualanId], references: [id])

  @@unique([penjualanId, sertifikatUrutan])
  @@index([customerId], map: "suket_pph_customer_id_fkey")
  @@map("suket_pph")
}

model FakturPajakPpn {
  id               Int       @id @default(autoincrement())
  customerId       Int       @map("customer_id")
  penjualanId      Int       @map("penjualan_id")
  sertifikatUrutan Int       @default(1) @map("sertifikat_urutan")
  fileFaktur       String    @map("file_faktur") @db.VarChar(500)
  uploadedBy       Int?      @map("uploaded_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  customer         Customer  @relation(fields: [customerId], references: [id])
  penjualan        Penjualan @relation(fields: [penjualanId], references: [id])

  @@unique([penjualanId, sertifikatUrutan])
  @@index([customerId], map: "faktur_pajak_ppn_customer_id_fkey")
  @@map("faktur_pajak_ppn")
}

model DetailKavlingPajak {
  id                      Int       @id @default(autoincrement())
  penjualanId             Int       @unique @map("penjualan_id")
  lantai                  String?   @db.VarChar(10)
  luasBangunan            String?   @map("luas_bangunan") @db.VarChar(20)
  lokasiStrategis         String?   @map("lokasi_strategis") @db.VarChar(50)
  tanggalAkadPpjb         DateTime? @map("tanggal_akad_ppjb") @db.Date
  akadPpjb                String?   @map("akad_ppjb") @db.VarChar(100)
  tanggalAkadAjbPpat      DateTime? @map("tanggal_akad_ajb_ppat") @db.Date
  tanggalPembayaranPph    DateTime? @map("tanggal_pembayaran_pph") @db.Date
  tanggalPembayaranBphtb  DateTime? @map("tanggal_pembayaran_bphtb") @db.Date
  pembiayaan              String?   @db.VarChar(100)
